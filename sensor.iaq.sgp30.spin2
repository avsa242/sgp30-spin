{
----------------------------------------------------------------------------------------------------
    Filename:       sensor.iaq.sgp30.spin
    Description:    Driver for the Sensirion SGP30 Indoor Air Quality sensor
    Author:         Jesse Burt
    Started:        Jan 30, 2021
    Updated:        Mar 11, 2025
    Copyright (c) 2025 - See end of file for terms of use.
----------------------------------------------------------------------------------------------------
}

CON

    { default I/O settings; these can be overridden in the parent object }
    SCL         = 0
    SDA         = 1
    I2C_FREQ    = 100_000
    I2C_ADDR    = 0


    SLAVE_WR    = core.SLAVE_ADDR
    SLAVE_RD    = core.SLAVE_ADDR|1
    I2C_MAX_FREQ= core.I2C_MAX_FREQ


OBJ

    i2c:    "com.i2c"                           ' I2C engine
    core:   "core.con.sgp30"                    ' HW-specific constants
    crc:    "math.crc"                          ' CRC routines


VAR

    word _serial_num[3]


PUB null()
' This is not a top-level object


PUB start(): s
' Start using default I/O settings
    return startx(SCL, SDA, I2C_FREQ)


PUB startx(SCL_PIN, SDA_PIN, I2C_HZ): status
' Start the driver with custom I/O settings
'   SCL_PIN:    I2C clock, 0..63
'   SDA_PIN:    I2C data, 0..63
'   I2C_HZ:     I2C clock speed (max official specification is 400_000 but is unenforced)
'   Returns:
'       cog ID+1 of I2C engine on success
'       0 on failure
    if ( lookdown(SCL_PIN: 0..63) and lookdown(SDA_PIN: 0..63) )
        if ( status := i2c.init(SCL_PIN, SDA_PIN, I2C_HZ) )
            waitus(core.T_POR)                  ' wait for device startup
            if ( i2c.present(SLAVE_WR) )        ' test device bus presence
                return
    ' if this point is reached, something above failed
    ' Re-check I/O pin assignments, bus speed, connections, power
    ' Lastly - make sure you have at least one free core/cog
    return FALSE


PUB stop()
' Stop the driver
    i2c.deinit()


PUB defaults()
' Set factory defaults
    reset()


PUB co2_equiv(): c
' CO2/Carbon Dioxide equivalent concentration
'   Returns:
'       parts-per-million (u16, 400..60_000)
'       or -1, if data failed CRC check
    c := readreg(core.MEAS_IAQ)

    if ( c < 0 )
        return

    return (c & $ffff)


PUB dev_id(): i
' Read device identification
    return readreg(core.GET_FEATURES)


PUB iaq_data(): w
' Indoor air-quality data ADC words
'   Returns: [31..16]: TVOC, [15..0]: CO2
    return readreg(core.MEAS_RAW)


PUB reset()
' Reset the device
' NOTE: There is a delay of approximately 15 seconds after calling this method, during which
'       co2_equiv() will return 400ppm and tvoc() will return 0ppb
    writereg(core.IAQ_INIT)


PUB serial_num(p_buff): s
' Read device Serial Number
'   p_buff: pointer to array
' NOTE: p_buff must point to an array at least 6 bytes in length
' Returns:
'    0: success
'   -1: data failed CRC (data copied to buffer should not be trusted in this case)
    s := readreg(core.GET_SN)

    if ( s < 0 )
        return

    bytemove(p_buff, @_serial_num, 6)


PUB tvoc(): c
' Total Volatile Organic Compounds concentration
' Returns:
'   parts-per-billion (u16, 0..60_000)
'   or -1, if data failed CRC
    c := readreg(core.MEAS_IAQ)

    if ( c < 0 )
        return

    return ( (c >> 16) & $ffff)


PRI readreg(reg_nr): s | cmd_pkt, tmp, crcrd, rdcnt, len
' Read register value
    cmd_pkt.byte[0] := SLAVE_WR                 ' form command packet
    cmd_pkt.byte[1] := reg_nr.byte[1]
    cmd_pkt.byte[2] := reg_nr.byte[0]
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 3)


    case reg_nr                                 ' validate command
        core.MEAS_IAQ, core.GET_IAQ_BASE, core.MEAS_RAW:
            len := 2
        core.MEAS_TEST, core.GET_FEATURES, core.GET_TVOC_INCBASE:
            len := 1
        core.GET_SN:
            len := 3
            waitus(core.T_GET_SN)
        other:

    i2c.wait(SLAVE_RD)                  ' poll the sensor for readiness

    repeat rdcnt from 0 to len-1
        tmp := i2c.rdword_msbf(i2c.ACK)
        crcrd := i2c.rd_byte(rdcnt == (len-1))' read CRC; NAK if last byte
        if (crcrd == crc.sensirion_crc8(@tmp, 2))
            if ( reg_nr == core.GET_SN )
                word[@_serial_num][rdcnt] := tmp
            else
                s.word[rdcnt] := tmp
        else
            s := -1                     ' CRC error
            quit

    i2c.stop()
    return s

PRI writereg(reg_nr, len=0, val=0) | cmd_pkt, tmp
' Write register/issue command
    cmd_pkt.byte[0] := SLAVE_WR
    cmd_pkt.byte[1] := reg_nr.byte[1]
    cmd_pkt.byte[2] := reg_nr.byte[0]
    i2c.start()
    i2c.wrblock_lsbf(@cmd_pkt, 3)

    case reg_nr
        core.IAQ_INIT:
        core.SET_IAQ_BASE, core.SET_ABS_HUM, core.SET_TVOC_BASE:
            i2c.wrblock_lsbf(@val, len)
        other:
            return

    i2c.stop()

DAT
